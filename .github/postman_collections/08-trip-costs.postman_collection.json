					"raw": "{\n    \"trip_id\": 1,\n    \"vehicle_id\": 1,\n    \"cost_id\": \"TC-001-002\",\n    \"cost_label\": \"Diesel\",\n    \"group_id\": \"TC-G-001\",\n    \"amount\": 5000.00,\n    \"date\": \"20-12-2025\",\n    \"time\": \"10:30\",\n    \"notes\": \"Diesel refill at HP Pump\",\n    \"fuel_quantity\": 55.5,\n    \"fuel_rate\": 90.09,\n    \"km_per_liter\": 4.5\n}"
				},
				"url": {"raw": "{{base_url}}/trip-costs", "host": ["{{base_url}}"], "path": ["trip-costs"]}
			},
