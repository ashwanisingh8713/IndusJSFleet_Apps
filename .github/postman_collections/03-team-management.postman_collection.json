{
	"info": {
		"_postman_id": "fleet-api-03-team-management",
		"name": "03. Team Management",
		"description": "Team member management endpoints.\n\n## Role Permissions\n- Owner: Full access\n- General Manager: Can manage Manager/Supervisor\n- Manager/Supervisor: View only",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "base_url", "value": "https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api/v2", "type": "string"},
		{"key": "token", "value": "", "type": "string"},
		{"key": "member_id", "value": "2", "type": "string"}
	],
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
	},
	"item": [
		{
			"name": "Create General Manager",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"gm@example.com\",\n    \"mobile\": \"+919876543220\",\n    \"password\": \"password123\",\n    \"first_name\": \"General\",\n    \"last_name\": \"Manager\",\n    \"role\": \"general_manager\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members", "host": ["{{base_url}}"], "path": ["team", "members"]}
			}
		},
		{
			"name": "Create Manager",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"manager@example.com\",\n    \"mobile\": \"+919876543221\",\n    \"password\": \"password123\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Manager\",\n    \"role\": \"manager\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members", "host": ["{{base_url}}"], "path": ["team", "members"]}
			}
		},
		{
			"name": "Create Supervisor",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"supervisor@example.com\",\n    \"mobile\": \"+919876543222\",\n    \"password\": \"password123\",\n    \"first_name\": \"Jane\",\n    \"last_name\": \"Supervisor\",\n    \"role\": \"supervisor\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members", "host": ["{{base_url}}"], "path": ["team", "members"]}
			}
		},
		{
			"name": "List Team Members",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/team/members", "host": ["{{base_url}}"], "path": ["team", "members"]}
			}
		},
		{
			"name": "Get Team Member",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}"]}
			}
		},
		{
			"name": "Update Team Member",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"first_name\": \"John\",\n    \"last_name\": \"Updated\",\n    \"email\": \"john.updated@example.com\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}"]}
			}
		},
		{
			"name": "Toggle Team Member Active",
			"request": {
				"method": "PATCH",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}/toggle-active", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}", "toggle-active"]}
			}
		},
		{
			"name": "Change Team Member Role",
			"request": {
				"method": "PATCH",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"new_role\": \"supervisor\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}/change-role", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}", "change-role"]}
			}
		},
		{
			"name": "Reset Team Member Password",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"new_password\": \"newpassword123\"\n}"
				},
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}/reset-password", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}", "reset-password"]}
			}
		},
		{
			"name": "Delete Team Member",
			"request": {
				"method": "DELETE",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/team/members/{{member_id}}", "host": ["{{base_url}}"], "path": ["team", "members", "{{member_id}}"]}
			}
		}
	]
}

