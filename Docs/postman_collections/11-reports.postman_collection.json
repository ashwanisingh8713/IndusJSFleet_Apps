{
	"info": {
		"_postman_id": "fleet-api-11-reports",
		"name": "11. Reports & P/L",
		"description": "Financial reports and profit/loss analysis.\n\n## Access\n- ALL P&L Reports: Owner and General Manager ONLY\n- Manager and Supervisor cannot access these endpoints\n\n## Response Format\nAll cost breakdowns include:\n- `cost_id`: Unique identifier (e.g., TC-001-002)\n- `cost_label`: Human-readable name (e.g., Diesel)\n- `group_id`: Group identifier (e.g., TC-G-001)\n- `amount`: Total amount\n- `count`: Number of entries",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "base_url", "value": "https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api/v2", "type": "string"},
		{"key": "token", "value": "", "type": "string"},
		{"key": "trip_id", "value": "1", "type": "string"},
		{"key": "vehicle_id", "value": "1", "type": "string"}
	],
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
	},
	"item": [
		{
			"name": "Get Report Types",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/reports/types", "host": ["{{base_url}}"], "path": ["reports", "types"]}
			}
		},
		{
			"name": "Get Report Periods",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
