				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {
					"raw": "{{base_url}}/reports/profit-loss?period=monthly",
					"host": ["{{base_url}}"],
					"path": ["reports", "profit-loss"],
