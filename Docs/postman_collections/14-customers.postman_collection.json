{
	"info": {
		"_postman_id": "fleet-api-14-customers",
		"name": "14. Customers",
		"description": "Customer management endpoints.\n\n## Role Permissions\n- Create/Edit: Owner, GM, Manager\n- View: All roles\n- Statistics: Owner, GM only",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "base_url", "value": "https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api/v2", "type": "string"},
		{"key": "token", "value": "", "type": "string"},
		{"key": "customer_id", "value": "1", "type": "string"}
	],
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
	},
	"item": [
		{
			"name": "Create Customer",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"company_name\": \"ABC Logistics Pvt Ltd\",\n    \"person_name\": \"Rajesh Sharma\",\n    \"primary_contact\": \"+919876543210\",\n    \"secondary_contact\": \"+919876543211\",\n    \"company_address\": \"123, Industrial Area, Mumbai 400001\",\n    \"email\": \"rajesh@abclogistics.com\",\n    \"gst_number\": \"27AABCU9603R1ZM\",\n    \"notes\": \"Premium customer\"\n}"
				},
				"url": {"raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"]}
			}
		},
		{
			"name": "List Customers",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {
					"raw": "{{base_url}}/customers?page=1&per_page=20",
					"host": ["{{base_url}}"],
					"path": ["customers"],
					"query": [
						{"key": "page", "value": "1"},
						{"key": "per_page", "value": "20"},
						{"key": "search", "value": "ABC", "disabled": true},
						{"key": "is_active", "value": "true", "disabled": true}
					]
				}
			}
		},
		{
			"name": "Get Customer",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/customers/{{customer_id}}", "host": ["{{base_url}}"], "path": ["customers", "{{customer_id}}"]}
			}
		},
		{
			"name": "Update Customer",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"},
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"company_name\": \"ABC Logistics India Pvt Ltd\",\n    \"person_name\": \"Rajesh Kumar Sharma\",\n    \"primary_contact\": \"+919876543212\",\n    \"company_address\": \"456, New Industrial Area, Mumbai 400002\"\n}"
				},
				"url": {"raw": "{{base_url}}/customers/{{customer_id}}", "host": ["{{base_url}}"], "path": ["customers", "{{customer_id}}"]}
			}
		},
		{
			"name": "Toggle Customer Active",
			"request": {
				"method": "PATCH",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {"raw": "{{base_url}}/customers/{{customer_id}}/toggle-active", "host": ["{{base_url}}"], "path": ["customers", "{{customer_id}}", "toggle-active"]}
			}
		},
		{
			"name": "Get Customer Trips",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
				"url": {
					"raw": "{{base_url}}/customers/{{customer_id}}/trips?page=1&per_page=20",
					"host": ["{{base_url}}"],
					"path": ["customers", "{{customer_id}}", "trips"],
					"query": [
						{"key": "page", "value": "1"},
						{"key": "per_page", "value": "20"},
						{"key": "state", "value": "completed", "disabled": true}
					]
				}
			}
		}
	]
}

