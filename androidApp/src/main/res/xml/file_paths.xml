<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External public Downloads directory -->
    <external-path
        name="downloads"
        path="Download/" />

    <!-- External public Documents directory (sdcard) -->
    <external-path
        name="documents"
        path="Documents/" />

    <!-- IndusJS Fleet exported PDFs in Documents -->
    <external-path
        name="indusjs_pdfs"
        path="Documents/IndusJSFleet/exportedPdf/" />

    <!-- IndusJS Fleet exported PDFs in root sdcard -->
    <external-path
        name="indusjs_root_pdfs"
        path="IndusJSFleet/exportedPdf/" />

    <!-- Root external storage for legacy support -->
    <external-path
        name="external_root"
        path="." />

    <!-- App's cache directory -->
    <cache-path
        name="cache"
        path="." />

    <!-- App's external files directory -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- App's external Documents directory for PDFs -->
    <external-files-path
        name="external_documents"
        path="Documents/" />

    <!-- Exported PDFs in Documents directory -->
    <external-files-path
        name="exported_pdfs"
        path="Documents/exportedPdf/" />

    <!-- Cache directory for PDFs -->
    <cache-path
        name="pdf_cache"
        path="exportedPdf/" />

    <!-- App's internal files directory (fallback) -->
    <files-path
        name="internal_files"
        path="exportedPdf/" />
</paths>

