{
	"info": {
		"_postman_id": "fleet-api-00-api-info",
		"name": "00. API Info & Versioning",
		"description": "API information and versioning endpoints (no authentication required).\n\n## Base URLs\n- **Production**: `https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api/v2`\n- **Local**: `http://localhost:8080/api/v2`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "api_base", "value": "https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api", "type": "string"},
		{"key": "base_url", "value": "https://indusjs-fleet-docker-960880113496.asia-south2.run.app/api/v2", "type": "string"}
	],
	"item": [
		{
			"name": "Get API Info",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}", "host": ["{{api_base}}"]}
			}
		},
		{
			"name": "Get All API Versions",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/versions", "host": ["{{api_base}}"], "path": ["versions"]}
			}
		},
		{
			"name": "Get Current Version Info",
			"request": {
				"method": "GET",
				"header": [{"key": "X-API-Version", "value": "v2"}],
				"url": {"raw": "{{api_base}}/version", "host": ["{{api_base}}"], "path": ["version"]}
			}
		},
		{
			"name": "Get Version Details (v1)",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/versions/v1", "host": ["{{api_base}}"], "path": ["versions", "v1"]}
			}
		},
		{
			"name": "Get Version Details (v2)",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/versions/v2", "host": ["{{api_base}}"], "path": ["versions", "v2"]}
			}
		},
		{
			"name": "Get Version Changelog",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/versions/v1/changelog", "host": ["{{api_base}}"], "path": ["versions", "v1", "changelog"]}
			}
		},
		{
			"name": "Get Migration Guide",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/migration", "host": ["{{api_base}}"], "path": ["migration"]}
			}
		},
		{
			"name": "API Health Check",
			"request": {
				"method": "GET",
				"url": {"raw": "{{api_base}}/health", "host": ["{{api_base}}"], "path": ["health"]}
			}
		}
	]
}

